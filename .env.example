# Runtime database role (pooled connection)
DATABASE_URL=postgresql://runtime_user:password@host-pooler.neon.tech/database?sslmode=require
DATABASE_POOL_MAX=5

# Local/CI migration role only (direct connection; do not configure in Vercel runtime)
MIGRATION_DATABASE_URL=postgresql://migration_user:password@host.neon.tech/database?sslmode=require

# Auth and encryption
NEXTAUTH_URL=http://localhost:2206
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
ENTRY_KEK=replace-with-a-32-byte-base64-key
ADMIN_EMAIL_ALLOWLIST=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Public URLs and consented analytics
NEXT_PUBLIC_SITE_URL=http://localhost:2206
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_BUYMEACOFFEE_URL=

# Signup abuse protection
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,app.logr.space
PUBLIC_REGISTRATION_ENABLED=false

# Optional Sentry EU project
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set true only for preview CSP validation; production must enforce CSP.
CSP_REPORT_ONLY=false

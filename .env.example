# Neon pooled runtime connection
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/database?sslmode=require
DATABASE_POOL_MAX=5

# Local migration connection; do not configure this in Vercel
MIGRATION_DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Auth and encryption
NEXTAUTH_URL=http://localhost:2206
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
ENTRY_KEK=replace-with-a-32-byte-base64-key
ADMIN_EMAIL_ALLOWLIST=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Public URLs and consented analytics
NEXT_PUBLIC_SITE_URL=http://localhost:2206
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_BUYMEACOFFEE_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/wrobit

# Keep disabled until production smoke tests pass
PUBLIC_REGISTRATION_ENABLED=false

# Optional international integrations
INTL_INTEGRATIONS_ENABLED=true
INTL_COUNTRIES_ENABLED=PL
INTL_LATEST_RATE_TTL_MINUTES=30
INTL_STALE_RATE_ALERT_HOURS=48
INTL_NBP_ENABLED=true
INTL_ECB_ENABLED=true
INTL_HMRC_ENABLED=true
INTL_BOC_ENABLED=true
INTL_IRS_COMPATIBLE_ENABLED=true
INTL_RBA_ENABLED=true
INTL_VIES_ENABLED=true
HMRC_RATES_API_BASE=https://api.service.hmrc.gov.uk/misc/exchange-rates

# Optional GoCardless Bank Account Data import
INTL_BANK_IMPORT_ENABLED=false
INTL_BANK_PROVIDERS=
INTL_GOCARDLESS_SECRET_ID=
INTL_GOCARDLESS_SECRET_KEY=
INTL_GOCARDLESS_REQUISITION_ID=
